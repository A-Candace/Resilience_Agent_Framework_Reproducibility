{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListNYCResilienceData",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::nyc-resilience-data"
    },
    {
      "Sid": "ReadNYCResilienceData",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::nyc-resilience-data/*"
    }
  ]
}
