# ============================================================
# APPLICATION
# ============================================================

ENV=dev


# ============================================================
# AWS CREDENTIALS — LOCAL DEVELOPMENT
# ============================================================

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Uncomment and populate this only if AWS issued temporary credentials:
# AWS_SESSION_TOKEN=PUT_YOUR_SESSION_TOKEN_HERE

AWS_REGION=us-east-2
AWS_DEFAULT_REGION=us-east-2


# ============================================================
# AMAZON BEDROCK
# ============================================================

BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6


# ============================================================
# S3 DATA BUCKET
# Enter the bucket name only — do not include s3://
# ============================================================

DATA_S3_BUCKET=nyc-resilience-data

# The agentic configuration uses this variable separately.
# Use the exact same bucket name.
S3_BUCKET=nyc-resilience-data


# ============================================================
# S3 SOURCE LOCATIONS
# These must match the folders and filenames in your bucket.
# ============================================================

S3_CENSUS_TRACTS_PREFIX=raw/geospatial/census-tracts

S3_RISK_XLSX_KEY=raw/tabular/tract-attributes/Risk_Attributes_Table_v4.xlsx

S3_FLOOD_GRID_KEY=raw/geospatial/flood-forecast/nyc_flood_risk_grid_4km.geojson


# ============================================================
# LOCAL CONTAINER RUNTIME PATHS
# scripts/s3_assets.py downloads the S3 files here.
# ============================================================

DATA_RUNTIME_DIR=/app/data/runtime

LOCAL_CENSUS_TRACTS=/app/data/runtime/nyc_census_tracts.shp

RISK_XLSX=/app/data/runtime/Risk_Attributes_Table_v4.xlsx

FLOOD_GRID_PATH=/app/data/runtime/nyc_flood_risk_grid_4km.geojson


# ============================================================
# MLFLOW
# Leave MLFLOW_TRACKING_URI blank until an MLflow tracking
# server is running.
# ============================================================

MLFLOW_TRACKING_URI=
MLFLOW_EXPERIMENT=nyc-resilience-agent


# ============================================================
# MODEL STORAGE
# These can remain configured for future model deployment.
# Use the same bucket unless you created a separate model bucket.
# ============================================================

MODEL_S3_BUCKET=nyc-resilience-data
MODEL_S3_KEY=data/model-artifacts/production/model.pkl
MODEL_METADATA_S3_KEY=data/model-artifacts/production/metadata.json
MODEL_LOCAL_PATH=/app/model_cache/model.pkl


# ============================================================
# INTERNAL MODEL-RELOAD API
# Replace this with a long random secret.
# ============================================================

RELOAD_API_TOKEN=PUT_A_LONG_RANDOM_SECRET_HERE


# ============================================================
# AGENTIC SERVICES
# ============================================================

DATABASE_URL=postgresql+asyncpg://resilience:resilience@postgres:5432/resilience

SECRETS_PREFIX=nyc-resilience

PHOENIX_COLLECTOR_ENDPOINT=http://phoenix:4317
OTEL_SERVICE_NAME=nyc-resilience-orchestrator

MCP_GEOSPATIAL_URL=http://mcp-geospatial:8001/mcp
MCP_CALCULATORS_URL=http://mcp-calculators:8002/mcp
MCP_DATA_URL=http://mcp-data:8003/mcp
MCP_MODEL_URL=http://mcp-model:8004/mcp


# ============================================================
# POSTGRESQL
# ============================================================

POSTGRES_DB=resilience
POSTGRES_USER=resilience
POSTGRES_PASSWORD=PUT_A_PASSWORD_HERE

ORCHESTRATOR_URL=http://orchestrator:8090
