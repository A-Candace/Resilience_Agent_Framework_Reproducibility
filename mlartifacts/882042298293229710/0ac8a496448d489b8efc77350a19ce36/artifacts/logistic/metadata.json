{
  "model_family": "logistic-regression",
  "predictor_family": "precipitation-only",
  "features": [
    "precip_current_hour_mm",
    "precip_previous_6h_mm",
    "daily_total_precip_mm"
  ],
  "source_target": "minutes_above_1p5_inch",
  "continuous_target": "minutes_above_1inch",
  "binary_target": "actual_event",
  "binary_target_rule": "minutes_above_1inch > 1e-06",
  "classification_threshold": 0.5,
  "max_iter": 2000,
  "class_weight": "balanced",
  "train_fraction": 0.7,
  "validation_fraction": 0.15,
  "test_fraction": 0.15000000000000005,
  "train_end_hour": "2024-12-05 22:00:00+00:00",
  "validation_end_hour": "2025-10-18 10:00:00+00:00"
}